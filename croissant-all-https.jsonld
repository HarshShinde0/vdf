      "rdfs:label": "totalBands"
    },
    {
      "@id": "rai:dataAnnotationPlatform",
      "@type": "rdf:Property",
      "domainIncludes": {
        "@id": "schema:Dataset"
      },
      "rangeIncludes": {
        "@id": "schema:Text"
      },
