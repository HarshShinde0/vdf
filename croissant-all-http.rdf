<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:schema1="http://schema.org/"
>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/source">
    <schema1:rangeIncludes rdf:resource="http://mlcommons.org/croissant/FileSet"/>
    <schema1:rangeIncludes rdf:resource="http://mlcommons.org/croissant/DataSource"/>
    <schema1:rangeIncludes rdf:resource="http://mlcommons.org/croissant/RecordSet"/>
    <schema1:rangeIncludes rdf:resource="http://mlcommons.org/croissant/FileObject"/>
    <rdfs:comment>The data source of the field. This will generally reference a FileObject or FileSet's contents (e.g., a specific column of a table).</rdfs:comment>
    <schema1:domainIncludes rdf:resource="http://mlcommons.org/croissant/Field"/>
    <schema1:domainIncludes rdf:resource="http://mlcommons.org/croissant/RecordSet"/>
    <rdfs:label>source</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/geo/spatialResolution">
    <schema1:domainIncludes rdf:resource="http://schema.org/Dataset"/>
    <schema1:domainIncludes rdf:resource="http://mlcommons.org/croissant/RecordSet"/>
    <schema1:rangeIncludes rdf:resource="http://schema.org/Text"/>
    <schema1:rangeIncludes rdf:resource="http://schema.org/QuantitativeValue"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:comment>Nominal spatial resolution for the dataset or collection (e.g., '30m' or a QuantitativeValue with units). May be provided at dataset level or at record/collection level when resolution varies.</rdfs:comment>
    <rdfs:label>spatialResolution</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/regex">
    <schema1:rangeIncludes rdf:resource="http://schema.org/Text"/>
    <rdfs:comment>A regular expression to apply to the data.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:label>regex</rdfs:label>
    <schema1:domainIncludes rdf:resource="http://mlcommons.org/croissant/Transform"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://schema.org/distribution">
    <rdfs:label>distribution</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <schema1:domainIncludes rdf:resource="http://schema.org/Dataset"/>
    <schema1:rangeIncludes rdf:resource="http://mlcommons.org/croissant/FileSet"/>
    <schema1:rangeIncludes rdf:resource="http://mlcommons.org/croissant/FileObject"/>
    <rdfs:comment>By contrast with schema.org/Dataset, Croissant requires the distribution property to have values of type FileObject or FileSet.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/isLiveDataset">
    <rdfs:label>isLiveDataset</rdfs:label>
    <schema1:rangeIncludes rdf:resource="http://schema.org/Boolean"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <schema1:domainIncludes rdf:resource="http://schema.org/Dataset"/>
    <rdfs:comment>Indicates that the dataset is continuously updated instead of being versioned.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/RAI/dataImputationProtocol">
    <rdfs:comment>Description of data imputation process, if applicable.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:label>dataImputationProtocol</rdfs:label>
    <schema1:domainIncludes rdf:resource="http://schema.org/Dataset"/>
    <schema1:rangeIncludes rdf:resource="http://schema.org/Text"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/dataType">
    <schema1:domainIncludes rdf:resource="http://mlcommons.org/croissant/Field"/>
    <schema1:domainIncludes rdf:resource="http://mlcommons.org/croissant/RecordSet"/>
    <rdfs:comment>The data type of the field, identified by the URI of the corresponding class. It could be either an atomic type (e.g, sc:Integer) or a semantic type (e.g., sc:GeoLocation).</rdfs:comment>
    <rdfs:label>dataType</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <schema1:rangeIncludes rdf:resource="http://mlcommons.org/croissant/DataType"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/geo/spatialIndex">
    <schema1:domainIncludes rdf:resource="http://schema.org/Dataset"/>
    <schema1:domainIncludes rdf:resource="http://mlcommons.org/croissant/RecordSet"/>
    <schema1:rangeIncludes rdf:resource="http://schema.org/Text"/>
    <rdfs:label>spatialIndex</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:comment>Precomputed spatial index token(s) (e.g., DGGS cell ID or geohash-like key) to accelerate coarse spatial filtering and discovery at scale.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/RAI/personalSensitiveInformation">
    <schema1:domainIncludes rdf:resource="http://schema.org/Dataset"/>
    <schema1:rangeIncludes rdf:resource="http://schema.org/Text"/>
    <rdfs:comment>Sensitive Human Attribute(s)- Gender, Socio-economic status, Geography, Language, Age, Culture, Experience or Seniority, Others (please specify), if applicable.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:label>personalSensitiveInformation</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/key">
    <schema1:domainIncludes rdf:resource="http://mlcommons.org/croissant/RecordSet"/>
    <rdfs:label>key</rdfs:label>
    <schema1:rangeIncludes rdf:resource="http://mlcommons.org/croissant/Field"/>
    <rdfs:comment>One or more fields whose values uniquely identify each record in the RecordSet. (See example below.)</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/fileObject">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <schema1:rangeIncludes rdf:resource="http://mlcommons.org/croissant/FileObject"/>
    <schema1:domainIncludes rdf:resource="http://mlcommons.org/croissant/DataSource"/>
    <rdfs:label>fileObject</rdfs:label>
    <rdfs:comment>The id of a FileObject that is the source of the data.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/RAI/annotatorDemographics">
    <rdfs:comment>List of demographics specifications about the annotators, if applicable.</rdfs:comment>
    <rdfs:label>annotatorDemographics</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <schema1:domainIncludes rdf:resource="http://schema.org/Dataset"/>
    <schema1:rangeIncludes rdf:resource="http://schema.org/Text"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/geo/channelList">
    <schema1:rangeIncludes rdf:resource="http://schema.org/Text"/>
    <rdfs:comment>List of wavelength channels (e.g., 171Å, 193Å) used within geocr:MultiWavelengthConfiguration.</rdfs:comment>
    <rdfs:label>channelList</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <schema1:domainIncludes rdf:resource="http://mlcommons.org/croissant/geo/MultiWavelengthConfiguration"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/equivalentProperty">
    <schema1:rangeIncludes rdf:resource="http://schema.org/URL"/>
    <rdfs:comment>A property that is equivalent to this Field. Used in the case a dataType is specified on the RecordSet to map specific fields to specific properties associated with that dataType.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:label>equivalentProperty</rdfs:label>
    <schema1:domainIncludes rdf:resource="http://mlcommons.org/croissant/Field"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/geo/bandConfiguration">
    <schema1:rangeIncludes rdf:resource="http://schema.org/Text"/>
    <schema1:rangeIncludes rdf:resource="http://mlcommons.org/croissant/geo/BandConfiguration"/>
    <rdfs:comment>Configuration describing raster band organization and semantics for a dataset or asset (e.g., band ordering and names).</rdfs:comment>
    <schema1:domainIncludes rdf:resource="http://mlcommons.org/croissant/Field"/>
    <schema1:domainIncludes rdf:resource="http://schema.org/Dataset"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:label>bandConfiguration</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/geo/bandNamesList">
    <rdfs:label>bandNamesList</rdfs:label>
    <rdfs:comment>Ordered list of band names corresponding to the band stack described by geocr:bandConfiguration.</rdfs:comment>
    <schema1:rangeIncludes rdf:resource="http://schema.org/Text"/>
    <schema1:domainIncludes rdf:resource="http://mlcommons.org/croissant/geo/BandConfiguration"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/ContentExtractionEnumeration">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Class"/>
    <rdfs:subClassOf rdf:resource="http://schema.org/Enumeration"/>
    <rdfs:label>ContentExtractionEnumeration</rdfs:label>
    <rdfs:comment>Specifies which content to extract from a file. One of "all", "lines", or "lineNumbers".</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/extract">
    <schema1:domainIncludes rdf:resource="http://mlcommons.org/croissant/DataSource"/>
    <schema1:rangeIncludes rdf:resource="http://mlcommons.org/croissant/Extract"/>
    <rdfs:label>extract</rdfs:label>
    <rdfs:comment>The extraction method from the provided source.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/TestSplit">
    <rdfs:comment>Test split.</rdfs:comment>
    <rdf:type rdf:resource="http://mlcommons.org/croissant/Split"/>
    <rdfs:label>TestSplit</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/subField">
    <schema1:domainIncludes rdf:resource="http://mlcommons.org/croissant/Field"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:label>subField</rdfs:label>
    <rdfs:comment>Another Field that is nested inside this one.</rdfs:comment>
    <schema1:rangeIncludes rdf:resource="http://mlcommons.org/croissant/Field"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/md5">
    <schema1:domainIncludes rdf:resource="http://mlcommons.org/croissant/FileObject"/>
    <rdfs:comment>The MD5 hash of the file.</rdfs:comment>
    <rdfs:label>md5</rdfs:label>
    <schema1:rangeIncludes rdf:resource="http://schema.org/Text"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/RAI/dataCollectionRawData">
    <schema1:domainIncludes rdf:resource="http://schema.org/Dataset"/>
    <rdfs:comment>Description of the raw data i.e. source of the data.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:label>dataCollectionRawData</rdfs:label>
    <schema1:rangeIncludes rdf:resource="http://schema.org/Text"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/SegmentationMask">
    <rdfs:subClassOf rdf:resource="http://schema.org/StructuredValue"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#class"/>
    <rdfs:label>SegmentationMask</rdfs:label>
    <rdfs:comment>A data type representing a segmentation mask.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/annotation">
    <rdfs:label>annotation</rdfs:label>
    <schema1:domainIncludes rdf:resource="http://mlcommons.org/croissant/Field"/>
    <schema1:domainIncludes rdf:resource="http://mlcommons.org/croissant/RecordSet"/>
    <rdfs:comment>One or more data-level annotations that apply to the entire record or field.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <schema1:rangeIncludes rdf:resource="http://mlcommons.org/croissant/Field"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/RecordSet">
    <rdfs:comment>A description of a set of structured records from one or more data sources and their structure, expressed as a set of fields.</rdfs:comment>
    <rdfs:label>RecordSet</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://schema.org/Intangible"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/transform">
    <schema1:domainIncludes rdf:resource="http://mlcommons.org/croissant/DataSource"/>
    <rdfs:comment>A transformation to apply on source data on top of the extracted method as specified through extract, e.g., a regular expression or JSON query.</rdfs:comment>
    <rdfs:label>transform</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <schema1:rangeIncludes rdf:resource="http://mlcommons.org/croissant/Transform"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/parentField">
    <rdfs:comment>A special case of SubField that should be hidden because it references a Field that already appears in the RecordSet.</rdfs:comment>
    <schema1:domainIncludes rdf:resource="http://mlcommons.org/croissant/Field"/>
    <schema1:rangeIncludes rdf:resource="http://mlcommons.org/croissant/Field"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:label>parentField</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/geo/spectralBandMetadata">
    <schema1:rangeIncludes rdf:resource="http://mlcommons.org/croissant/geo/SpectralBand"/>
    <schema1:rangeIncludes rdf:resource="http://schema.org/Text"/>
    <schema1:domainIncludes rdf:resource="http://schema.org/Dataset"/>
    <schema1:domainIncludes rdf:resource="http://mlcommons.org/croissant/Field"/>
    <rdfs:comment>Per-band spectral metadata for EO imagery (e.g., center wavelength, bandwidth), represented as one or more geocr:SpectralBand entries.</rdfs:comment>
    <rdfs:label>spectralBandMetadata</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/containedIn">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <schema1:domainIncludes rdf:resource="http://mlcommons.org/croissant/FileSet"/>
    <schema1:domainIncludes rdf:resource="http://mlcommons.org/croissant/FileObject"/>
    <schema1:rangeIncludes rdf:resource="http://mlcommons.org/croissant/FileSet"/>
    <schema1:rangeIncludes rdf:resource="http://mlcommons.org/croissant/FileObject"/>
    <schema1:rangeIncludes rdf:resource="http://mlcommons.org/croissant/DataSource"/>
    <rdfs:label>containedIn</rdfs:label>
    <rdfs:comment>Another FileObject, FileSet or DataSource that this one is contained in, e.g., in the case of a file extracted from an archive. When this property is present, the contentUrl is evaluated as a relative path within the container object.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/geo/timeSeriesIndex">
    <schema1:rangeIncludes rdf:resource="http://schema.org/Text"/>
    <schema1:rangeIncludes rdf:resource="http://mlcommons.org/croissant/Field"/>
    <rdfs:label>timeSeriesIndex</rdfs:label>
    <schema1:domainIncludes rdf:resource="http://mlcommons.org/croissant/RecordSet"/>
    <rdfs:comment>Identifies the record-level field used to order/index observations in a time series (e.g., a timestamp field in a RecordSet).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/sdVersion">
    <rdfs:label>sdVersion</rdfs:label>
    <schema1:rangeIncludes rdf:resource="http://schema.org/Text"/>
    <schema1:rangeIncludes rdf:resource="http://schema.org/Number"/>
    <schema1:domainIncludes rdf:resource="http://schema.org/Dataset"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:comment>The version of the dataset metadata, which may be distinct from the version of the dataset content.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/jsonPath">
    <schema1:domainIncludes rdf:resource="http://mlcommons.org/croissant/Extract"/>
    <schema1:rangeIncludes rdf:resource="http://schema.org/Text"/>
    <rdfs:label>jsonPath</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:comment>In case the data source is JSON data, a path expression to extract a subset of the data.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/FilePropertyEnumeration">
    <rdfs:comment>Specifies a property of a FileObject. One of "fullPath" or "fileName".</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://schema.org/Enumeration"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Class"/>
    <rdfs:label>FilePropertyEnumeration</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/RAI/dataUseCases">
    <schema1:domainIncludes rdf:resource="http://schema.org/Dataset"/>
    <schema1:rangeIncludes rdf:resource="http://schema.org/Text"/>
    <rdfs:comment>Dataset Use(s) - Training, Testing, Validation, Development or Production Use, Fine Tuning, Others (please specify), Usage Guidelines. Recommended uses.</rdfs:comment>
    <rdfs:label>dataUseCases</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/value">
    <rdfs:comment>An optional constant value for the field.</rdfs:comment>
    <rdfs:label>value</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <schema1:rangeIncludes rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON"/>
    <schema1:domainIncludes rdf:resource="http://mlcommons.org/croissant/Field"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/geo/SpectralBand">
    <rdfs:subClassOf rdf:resource="http://schema.org/StructuredValue"/>
    <rdfs:label>SpectralBand</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdfs:comment>Structured per-band spectral metadata entry (e.g., center wavelength and bandwidth). Intended to be used as items within geocr:spectralBandMetadata.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/RAI/dataBiases">
    <schema1:domainIncludes rdf:resource="http://schema.org/Dataset"/>
    <rdfs:comment>Description of biases in dataset, if applicable.</rdfs:comment>
    <rdfs:label>dataBiases</rdfs:label>
    <schema1:rangeIncludes rdf:resource="http://schema.org/Text"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/format">
    <schema1:domainIncludes rdf:resource="http://mlcommons.org/croissant/DataSource"/>
    <rdfs:comment>A format to parse the values of the data from text, e.g., a date format or number format.</rdfs:comment>
    <schema1:rangeIncludes rdf:resource="http://mlcommons.org/croissant/Format"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:label>format</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/BoundingBox">
    <rdfs:subClassOf rdf:resource="http://schema.org/Text"/>
    <rdfs:label>Label</rdfs:label>
    <rdfs:comment>A data type representing a bounding box.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/RAI/dataReleaseMaintenancePlan">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:label>dataReleaseMaintenancePlan</rdfs:label>
    <schema1:domainIncludes rdf:resource="http://schema.org/Dataset"/>
    <schema1:rangeIncludes rdf:resource="http://schema.org/Text"/>
    <rdfs:comment>Versioning information in terms of the updating timeframe, the maintainers, and the deprecation policies.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/TrainSplit">
    <rdfs:label>TrainSplit</rdfs:label>
    <rdf:type rdf:resource="http://mlcommons.org/croissant/Split"/>
    <rdfs:comment>Training split.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/readLines">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:label>readLines</rdfs:label>
    <schema1:domainIncludes rdf:resource="http://mlcommons.org/croissant/Transform"/>
    <schema1:rangeIncludes rdf:resource="http://schema.org/Boolean"/>
    <rdfs:comment>Read the content of the file line by line.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/geo/temporalResolution">
    <schema1:rangeIncludes rdf:resource="http://schema.org/QuantitativeValue"/>
    <schema1:rangeIncludes rdf:resource="http://schema.org/Text"/>
    <rdfs:label>temporalResolution</rdfs:label>
    <schema1:domainIncludes rdf:resource="http://schema.org/Dataset"/>
    <schema1:domainIncludes rdf:resource="http://mlcommons.org/croissant/RecordSet"/>
    <rdfs:comment>Temporal cadence of the dataset or collection (e.g., 1 month), typically expressed as a QuantitativeValue (value + unit), or as text. May be provided at dataset level or at record/collection level when cadence varies.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/Split">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#class"/>
    <rdfs:label>Split</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://schema.org/Enumeration"/>
    <rdfs:comment>Splits for training a machine learning, typically test, train and validation.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/geo/observatory">
    <rdfs:label>observatory</rdfs:label>
    <schema1:rangeIncludes rdf:resource="http://schema.org/Text"/>
    <schema1:domainIncludes rdf:resource="http://mlcommons.org/croissant/geo/SolarInstrumentCharacteristics"/>
    <rdfs:comment>Observatory/platform identifier used within geocr:SolarInstrumentCharacteristics (for later mapping to SPASE).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/RAI/dataAnnotationPlatform">
    <schema1:rangeIncludes rdf:resource="http://schema.org/Text"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:comment>Platform, tool, or library used to collect annotations by human annotators, if applicable.</rdfs:comment>
    <schema1:domainIncludes rdf:resource="http://schema.org/Dataset"/>
    <rdfs:label>dataAnnotationPlatform</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/fileSet">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:comment>The id of a FileSet that is the source of the data.</rdfs:comment>
    <schema1:rangeIncludes rdf:resource="http://mlcommons.org/croissant/FileSet"/>
    <schema1:domainIncludes rdf:resource="http://mlcommons.org/croissant/DataSource"/>
    <rdfs:label>fileSet</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/geo/samplingStrategy">
    <schema1:rangeIncludes rdf:resource="http://schema.org/Text"/>
    <rdfs:comment>Description of how samples were selected or constructed (e.g., chip/windowing strategy, filtering criteria) to support reproducibility and interpretation.</rdfs:comment>
    <schema1:domainIncludes rdf:resource="http://schema.org/Dataset"/>
    <rdfs:label>samplingStrategy</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/FileObject">
    <rdfs:label>FileObject</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://schema.org/DataDownload"/>
    <rdfs:comment>An individual file that is part of a dataset.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/RAI/dataCollectionMissingData">
    <rdfs:label>dataCollectionMissingData</rdfs:label>
    <schema1:rangeIncludes rdf:resource="http://schema.org/Text"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:comment>Description of missing data in structured/unstructured form.</rdfs:comment>
    <schema1:domainIncludes rdf:resource="http://schema.org/Dataset"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/RAI/dataManipulationProtocol">
    <schema1:rangeIncludes rdf:resource="http://schema.org/Text"/>
    <rdfs:comment>Description of data manipulation process, if applicable.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:label>dataManipulationProtocol</rdfs:label>
    <schema1:domainIncludes rdf:resource="http://schema.org/Dataset"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/geo/recordEndpoint">
    <schema1:domainIncludes rdf:resource="http://schema.org/Dataset"/>
    <schema1:rangeIncludes rdf:resource="http://schema.org/Text"/>
    <schema1:rangeIncludes rdf:resource="http://schema.org/URL"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:comment>A service endpoint that provides programmatic access to the dataset's metadata records (e.g., listing, paging, and filtering records).</rdfs:comment>
    <rdfs:label>recordEndpoint</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/RAI/dataSocialImpact">
    <schema1:domainIncludes rdf:resource="http://schema.org/Dataset"/>
    <schema1:rangeIncludes rdf:resource="http://schema.org/Text"/>
    <rdfs:comment>Discussion of social impact, if applicable.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:label>dataSocialImpact</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/geo/spatialBias">
    <schema1:rangeIncludes rdf:resource="http://schema.org/Text"/>
    <schema1:domainIncludes rdf:resource="http://schema.org/Dataset"/>
    <rdfs:comment>Description of spatial representativeness limitations (e.g., geographic concentration, under-sampled regions/biomes) that may affect model generalization and evaluation.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:label>spatialBias</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/ValidationSplit">
    <rdfs:label>ValidationSplit</rdfs:label>
    <rdf:type rdf:resource="http://mlcommons.org/croissant/Split"/>
    <rdfs:comment>Validation split.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/repeated">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:label>repeated</rdfs:label>
    <rdfs:comment>If true, then the Field is a list of values of type dataType.</rdfs:comment>
    <schema1:rangeIncludes rdf:resource="http://schema.org/Boolean"/>
    <schema1:domainIncludes rdf:resource="http://mlcommons.org/croissant/Field"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/Transform">
    <rdfs:subClassOf rdf:resource="http://schema.org/Intangible"/>
    <rdfs:comment>Specifies how to transform data extracted from a DataSource. The type of transformation depends on the type of content, e.g., a regular expression to appy on text, or a jsonQuery to transform JSON content.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Class"/>
    <rdfs:label>Transform</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/geo/centerWavelength">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <schema1:rangeIncludes rdf:resource="http://schema.org/QuantitativeValue"/>
    <rdfs:label>centerWavelength</rdfs:label>
    <rdfs:comment>Center wavelength for a geocr:SpectralBand entry (typically in geocr:spectralBandMetadata), expressed as a QuantitativeValue.</rdfs:comment>
    <schema1:domainIncludes rdf:resource="http://mlcommons.org/croissant/geo/SpectralBand"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/geo/multiWavelengthConfiguration">
    <schema1:domainIncludes rdf:resource="http://schema.org/Dataset"/>
    <rdfs:comment>Composite property to group multi-wavelength configuration information for Space Weather / heliophysics datasets; intended to map to SPASE constructs.</rdfs:comment>
    <schema1:rangeIncludes rdf:resource="http://mlcommons.org/croissant/geo/MultiWavelengthConfiguration"/>
    <schema1:rangeIncludes rdf:resource="http://schema.org/Text"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:label>multiWavelengthConfiguration</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/Label">
    <rdfs:comment>A machine learning label.</rdfs:comment>
    <rdfs:label>Label</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://schema.org/Intangible"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/RAI/dataAnnotationAnalysis">
    <schema1:domainIncludes rdf:resource="http://schema.org/Dataset"/>
    <schema1:rangeIncludes rdf:resource="http://schema.org/Text"/>
    <rdfs:comment>Considerations related to the process of converting the "raw" annotations into the labels that are ultimately packaged in a dataset - Uncertainty or disagreement between annotations on each instance as a signal in the dataset, analysis of systematic disagreements between annotators of different socio demographic group,  how the final dataset annotations will relate to individual annotator responses.</rdfs:comment>
    <rdfs:label>dataAnnotationAnalysis</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/Format">
    <rdfs:subClassOf rdf:resource="http://schema.org/Text"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Class"/>
    <rdfs:comment>Specifies how to parse the format of the data from a string representation. For example, format may hold a date format string, a number format, or a bounding box format.</rdfs:comment>
    <rdfs:label>Format</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/RAI/dataAnnotationProtocol">
    <schema1:rangeIncludes rdf:resource="http://schema.org/Text"/>
    <rdfs:label>dataAnnotationProtocol</rdfs:label>
    <schema1:domainIncludes rdf:resource="http://schema.org/Dataset"/>
    <rdfs:comment>Description of annotations (labels, ratings) produced, including how these were created or authored - Annotation Workforce Type, Annotation Characteristic(s), Annotation Description(s), Annotation Task(s), Annotation Distribution(s).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/geo/bandwidth">
    <schema1:domainIncludes rdf:resource="http://mlcommons.org/croissant/geo/SpectralBand"/>
    <rdfs:label>bandwidth</rdfs:label>
    <schema1:rangeIncludes rdf:resource="http://schema.org/QuantitativeValue"/>
    <rdfs:comment>Spectral bandwidth for a geocr:SpectralBand entry (typically in geocr:spectralBandMetadata), expressed as a QuantitativeValue.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/geo/BandConfiguration">
    <rdfs:label>BandConfiguration</rdfs:label>
    <rdfs:comment>Structured description of raster band organization and semantics (e.g., band count and ordered band names). Intended to be used as the value of geocr:bandConfiguration.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://schema.org/StructuredValue"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/recordSet">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:label>recordSet</rdfs:label>
    <rdfs:comment>The id of a RecordSet that is the source of the data.</rdfs:comment>
    <schema1:rangeIncludes rdf:resource="http://mlcommons.org/croissant/RecordSet"/>
    <schema1:domainIncludes rdf:resource="http://mlcommons.org/croissant/DataSource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/Field">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Class"/>
    <rdfs:comment>A component of the structure of a RecordSet, such as a column of a table.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://schema.org/Intangible"/>
    <rdfs:label>Field</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/RAI/machineAnnotationTools">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <schema1:domainIncludes rdf:resource="http://schema.org/Dataset"/>
    <rdfs:label>machineAnnotationTools</rdfs:label>
    <schema1:rangeIncludes rdf:resource="http://schema.org/Text"/>
    <rdfs:comment>List of software used for data annotation (e.g., concept extraction, NER, and additional characteristics of the tools used for annotation to allow for replication or extension).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/FileSet">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Class"/>
    <rdfs:comment>A set of homogeneous files extracted from a container, optionally filtered by inclusion and/or exclusion filters.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://schema.org/DataDownload"/>
    <rdfs:label>FileSet</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/RAI/dataLimitations">
    <rdfs:label>dataLimitations</rdfs:label>
    <schema1:domainIncludes rdf:resource="http://schema.org/Dataset"/>
    <rdfs:comment>Known limitations - Data generalization limits (e.g related to data distribution, data quality issues, or data sources) and on-recommended uses, if applicable.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <schema1:rangeIncludes rdf:resource="http://schema.org/Text"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/field">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:comment>A data element that appears in the records of the RecordSet (e.g., one column of a table).</rdfs:comment>
    <rdfs:label>field</rdfs:label>
    <schema1:domainIncludes rdf:resource="http://mlcommons.org/croissant/RecordSet"/>
    <schema1:rangeIncludes rdf:resource="http://mlcommons.org/croissant/Field"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/geo/instrument">
    <rdfs:label>instrument</rdfs:label>
    <rdfs:comment>Instrument identifier used within geocr:SolarInstrumentCharacteristics (for later mapping to SPASE).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <schema1:rangeIncludes rdf:resource="http://schema.org/Text"/>
    <schema1:domainIncludes rdf:resource="http://mlcommons.org/croissant/geo/SolarInstrumentCharacteristics"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/geo/SolarInstrumentCharacteristics">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdfs:subClassOf rdf:resource="http://schema.org/StructuredValue"/>
    <rdfs:label>SolarInstrumentCharacteristics</rdfs:label>
    <rdfs:comment>Structured description of solar/heliophysics instrument and observatory characteristics for Space Weather datasets (e.g., observatory/platform and instrument identifiers). Intended to be used as the value of geocr:solarInstrumentCharacteristics.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/RAI/dataPreprocessingProtocol">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <schema1:domainIncludes rdf:resource="http://schema.org/Dataset"/>
    <rdfs:label>dataPreprocessingProtocol</rdfs:label>
    <rdfs:comment>Description of the steps that were required to bring collected data to a state that can be processed by an ML model/algorithm, e.g. filtering out incomplete entries etc, if applicable.</rdfs:comment>
    <schema1:rangeIncludes rdf:resource="http://schema.org/Text"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/content">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:label>content</rdfs:label>
    <rdfs:comment>What to extract from the data source content, e.g., lines.</rdfs:comment>
    <schema1:domainIncludes rdf:resource="http://mlcommons.org/croissant/Extract"/>
    <schema1:rangeIncludes rdf:resource="http://mlcommons.org/croissant/ContentExtractionEnumeration"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/citeAs">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:comment>How to cite this dataset. Ideally, citations should be expressed using the bibtex format. Note that this is different from schema.org/citation, which is used to make a citation to another publication from this dataset.</rdfs:comment>
    <schema1:domainIncludes rdf:resource="http://schema.org/Dataset"/>
    <rdfs:label>citeAs</rdfs:label>
    <schema1:rangeIncludes rdf:resource="http://schema.org/Text"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/RAI/annotationsPerItem">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <schema1:domainIncludes rdf:resource="http://schema.org/Dataset"/>
    <schema1:rangeIncludes rdf:resource="http://schema.org/Text"/>
    <rdfs:comment>Number of human labels per dataset item, if applicable.</rdfs:comment>
    <rdfs:label>annotationsPerItem</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/DataType">
    <rdfs:comment>The data type of values expected for a Field in a RecordSet. This class is inspired by the Datatype class in CSVW. In addition to simple atomic types, types can be semantic types, such as schema.org classes, as well types defined in other vocabularies.</rdfs:comment>
    <rdfs:label>DataType</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Class"/>
    <rdfs:subClassOf rdf:resource="http://schema.org/URL"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/excludes">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:comment>A glob pattern that specifies the files to exclude. The pattern is evaluated from the root of the containedIn contents, after the includes patterns have been evaluated.</rdfs:comment>
    <rdfs:label>excludes</rdfs:label>
    <schema1:domainIncludes rdf:resource="http://mlcommons.org/croissant/FileSet"/>
    <schema1:rangeIncludes rdf:resource="http://schema.org/Text"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/geo/totalBands">
    <schema1:domainIncludes rdf:resource="http://mlcommons.org/croissant/geo/BandConfiguration"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <schema1:rangeIncludes rdf:resource="http://schema.org/Integer"/>
    <rdfs:comment>Total number of bands for an asset or dataset described by geocr:bandConfiguration.</rdfs:comment>
    <rdfs:label>totalBands</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/data">
    <schema1:rangeIncludes rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON"/>
    <rdfs:label>data</rdfs:label>
    <rdfs:comment>One or more inlined records that constitute the data of the RecordSet, typically used for small enumeration values.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <schema1:domainIncludes rdf:resource="http://mlcommons.org/croissant/RecordSet"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/fileProperty">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:comment>The file property to extract from the data source metadata, e.g., the filename.</rdfs:comment>
    <rdfs:label>fileProperty</rdfs:label>
    <schema1:rangeIncludes rdf:resource="http://mlcommons.org/croissant/FilePropertyEnumeration"/>
    <schema1:domainIncludes rdf:resource="http://mlcommons.org/croissant/Extract"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/Extract">
    <rdfs:subClassOf rdf:resource="http://schema.org/Intangible"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Class"/>
    <rdfs:comment>Specifies how to extract data from a DataSource. The extraction mechanism depends on the type of content, e.g., a column name for tabular data, or a jsonPath for JSON data.</rdfs:comment>
    <rdfs:label>Extract</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/column">
    <rdfs:label>column</rdfs:label>
    <schema1:domainIncludes rdf:resource="http://mlcommons.org/croissant/Extract"/>
    <schema1:rangeIncludes rdf:resource="http://schema.org/Text"/>
    <rdfs:comment>In case the data source is tabular, the id of a column to extract.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/DataSource">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Class"/>
    <rdfs:comment>A source of data, optionally transformed before being used.</rdfs:comment>
    <rdfs:label>DataSource</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://schema.org/Intangible"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/RAI/dataCollectionType">
    <schema1:rangeIncludes rdf:resource="http://schema.org/Text"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <schema1:domainIncludes rdf:resource="http://schema.org/Dataset"/>
    <rdfs:comment>Define the data collection type. Recommended values: Surveys, Secondary Data analysis, Physical data collection, Direct measurement, Document analysis, Manual Human Curator, Software Collection, Experiments, Web Scraping, Web API, Focus groups, Self-reporting, Customer feedback data, User-generated content data, Passive Data Collection, Others.</rdfs:comment>
    <rdfs:label>dataCollectionType</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/geo/coordinateReferenceSystem">
    <rdfs:comment>Coordinate reference system (CRS) identifier (e.g., EPSG code) used to interpret spatial data in the dataset.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <schema1:domainIncludes rdf:resource="http://schema.org/Dataset"/>
    <schema1:rangeIncludes rdf:resource="http://schema.org/Text"/>
    <rdfs:label>coordinateReferenceSystem</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/references">
    <rdfs:comment>Another Field of another RecordSet that this field references. This is the equivalent of a foreign key reference in a relational database.</rdfs:comment>
    <schema1:domainIncludes rdf:resource="http://mlcommons.org/croissant/Field"/>
    <schema1:rangeIncludes rdf:resource="http://mlcommons.org/croissant/Field"/>
    <rdfs:label>references</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/separator">
    <schema1:rangeIncludes rdf:resource="http://schema.org/Text"/>
    <rdfs:comment>A separator to use parse the data into an array.</rdfs:comment>
    <schema1:domainIncludes rdf:resource="http://mlcommons.org/croissant/Transform"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:label>separator</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/arrayShape">
    <schema1:domainIncludes rdf:resource="http://mlcommons.org/croissant/Field"/>
    <schema1:rangeIncludes rdf:resource="http://schema.org/Text"/>
    <rdfs:label>arrayShape</rdfs:label>
    <rdfs:comment>Shape of the data tensor/array associated with a field (e.g., [height, width, bands] for imagery).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/includes">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <schema1:domainIncludes rdf:resource="http://mlcommons.org/croissant/FileSet"/>
    <rdfs:label>includes</rdfs:label>
    <rdfs:comment>A glob pattern that specifies the files to include, e.g., ".jpg", "/foo/pic*.jpg". The pattern is evaluated from the root of the containedIn contents.</rdfs:comment>
    <schema1:rangeIncludes rdf:resource="http://schema.org/Text"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/geo/solarInstrumentCharacteristics">
    <rdfs:label>solarInstrumentCharacteristics</rdfs:label>
    <schema1:domainIncludes rdf:resource="http://schema.org/Dataset"/>
    <rdfs:comment>Composite property to group solar/heliophysics instrument characteristics for Space Weather datasets; intended to map to SPASE constructs.</rdfs:comment>
    <schema1:rangeIncludes rdf:resource="http://schema.org/Text"/>
    <schema1:rangeIncludes rdf:resource="http://mlcommons.org/croissant/geo/SolarInstrumentCharacteristics"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/RAI/dataCollection">
    <rdfs:comment>Description of the data collection process.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:label>dataCollection</rdfs:label>
    <schema1:rangeIncludes rdf:resource="http://schema.org/Text"/>
    <schema1:domainIncludes rdf:resource="http://schema.org/Dataset"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/geo/MultiWavelengthConfiguration">
    <rdfs:comment>Structured description of multi-wavelength channel configuration for Space Weather / heliophysics datasets (e.g., a list of wavelength channels). Intended to be used as the value of geocr:multiWavelengthConfiguration.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdfs:subClassOf rdf:resource="http://schema.org/StructuredValue"/>
    <rdfs:label>MultiWavelengthConfiguration</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/examples">
    <rdfs:comment>One more inlined records provided as example content of the RecordSet.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:label>examples</rdfs:label>
    <schema1:rangeIncludes rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON"/>
    <schema1:domainIncludes rdf:resource="http://mlcommons.org/croissant/RecordSet"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/unArchive">
    <rdfs:label>unArchive</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <schema1:domainIncludes rdf:resource="http://mlcommons.org/croissant/Transform"/>
    <schema1:rangeIncludes rdf:resource="http://schema.org/Boolean"/>
    <rdfs:comment>Extract the content of the archive.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://mlcommons.org/croissant/RAI/dataCollectionTimeframe">
    <schema1:rangeIncludes rdf:resource="http://schema.org/DateTime"/>
    <schema1:domainIncludes rdf:resource="http://schema.org/Dataset"/>
    <rdfs:label>dataCollectionTimeframe</rdfs:label>
    <rdfs:comment>Timeframe in terms of start and end date of the collection process, that it described as a DateTime indicating a time period in &lt;a href="https://en.wikipedia.org/wiki/ISO_8601#Time_intervals"&gt;ISO 8601 time interval format&lt;/a&gt;. For example, a collection time frame ranging from 2020 - 2022 can be indicated in ISO 8601 interval format via "2020/2022".</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
</rdf:RDF>
